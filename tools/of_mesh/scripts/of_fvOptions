// Bound T so the janaf inversion cannot run away; standard robustness
// measure for compressible simpleFoam on highly stretched BL meshes.
limitTemperature
{
    type            limitTemperature;
    active          yes;
    selectionMode   all;
    min             200;
    max             4000;
}
